# העתק לקובץ בשם .env ומלא ערכים
# מפתח מ-https://console.anthropic.com (בלעדיו הצ'אט יחזיר רק רשימת כתבות)
ANTHROPIC_API_KEY=

PORT=3000

# כל כמה שניות לבדוק כל מקור. ריק = ברירות מחדל לפי מקור (90-300 שניות).
# מינימום 5. ערכים נמוכים מאוד עלולים לגרום לחסימה מ-Reddit/Google.
POLL_SECONDS=

# ערוצי יוטיוב לעקוב אחריהם (מזהי ערוץ UC..., מופרדים בפסיק)
YOUTUBE_CHANNEL_IDS=

# פידים נוספים: שם|כתובת|סוג ; שם|כתובת|סוג   (סוג: news / community / video)
EXTRA_FEEDS=

# חדשות בשפות נוספות (Google News). ברירת מחדל: de,ja,zh,fr,es,he
# אפשר גם ru,ko,pt. ערך ריק (NEWS_LANGS=) מכבה.
NEWS_LANGS=

# חיפוש רשת רחב בכל האינטרנט דרך Brave Search API (אופציונלי, יש תוכנית חינמית מוגבלת)
BRAVE_API_KEY=

# מודלים (אופציונלי)
CHAT_MODEL=claude-sonnet-5-5
FAST_MODEL=claude-haiku-5-5

# תרגום כתבות לעברית: off לכיבוי. מודל התרגום (ברירת מחדל: FAST_MODEL)
TRANSLATE=
TRANSLATE_MODEL=

# הגבלת הודעות צ'אט לדקה לכל כתובת IP (הגנה על העלות)
CHAT_PER_MINUTE=15

# אם מוגדר, רענון ידני דורש כותרת X-Admin-Token
ADMIN_TOKEN=

# היכן נשמר המאגר (בענן - נתיב של דיסק קבוע)
DATA_DIR=
